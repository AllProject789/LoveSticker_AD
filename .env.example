# Copy to .env and fill in. .env is gitignored - never commit real values.

# Where the catalog will be published. Used to build raw.githubusercontent.com URLs
# and to sanity-check that the configured git remote matches.
GITHUB_OWNER=
GITHUB_REPOSITORY=romantic-sticker-catalog
GITHUB_BRANCH=main

# Only needed if an API-based upload is ever used instead of plain `git push`.
# Never commit this value. Read from the environment only.
# GITHUB_TOKEN=
