{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Romantic Sticker Catalog Manifest",
  "type": "object",
  "required": ["schema_version", "catalog_version", "generated_at", "total_packs", "total_pages", "pages", "repository"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "catalog_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "total_packs": { "type": "integer", "minimum": 0 },
    "total_pages": { "type": "integer", "minimum": 0 },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "file"],
        "additionalProperties": false,
        "properties": {
          "page": { "type": "integer", "minimum": 0 },
          "file": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repository": {
      "type": "object",
      "required": ["owner", "name", "branch"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    }
  }
}
