{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pack-detail.schema.json",
  "title": "Romantic Sticker Catalog Pack Detail",
  "type": "object",
  "required": ["identifier", "name", "publisher", "tray_image_url", "premium", "animated", "stickers"],
  "additionalProperties": false,
  "properties": {
    "identifier": { "type": ["integer", "string"] },
    "name": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string" },
    "tray_image_url": { "type": "string", "format": "uri" },
    "premium": { "type": "string" },
    "animated": { "type": "string" },
    "stickers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["thumbnail_url", "image_url", "emojis"],
        "additionalProperties": false,
        "properties": {
          "thumbnail_url": { "type": "string", "format": "uri" },
          "image_url": { "type": "string", "format": "uri" },
          "emojis": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
